# CPU-only for an easily reproduced local demo. GPU Docker support is separate.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /app

# Only project code and declarations; never bake locally trained weights into images.
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.13.0 \
    && python -m pip install --no-cache-dir transformers==4.57.6 safetensors==0.8.0

COPY trustdesk_unified_api_v06.py trustdesk_transformer_api_v05.py ./
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/artifacts \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8002
CMD ["python", "-m", "uvicorn", "trustdesk_unified_api_v06:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
